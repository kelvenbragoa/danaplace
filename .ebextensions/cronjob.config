files:
    "/etc/cron.d/schedule_run":
        mode: "000644"
        owner: root
        group: root
        content: |
            * * * * * root . /opt/elasticbeanstalk/support/envvars && /usr/bin/php /var/www/html/artisan schedule:run 1>> /dev/null 2>&1

commands:
    remove_old_cron:
        command: "rm -f /etc/cron.d/*.bak"
        ignoreErrors: true

files:
  "/etc/php.d/20-zip.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      extension=zip.so
commands:
  01_install_libzip:
    command: "dnf -y install libzip libzip-devel"
  02_install_zip:
    test: "php -r \"exit(extension_loaded('zip') ? 1 : 0);\""
    command: "pecl install zip"